{
  "dashboard": {
    "title": "OB Van Network Monitoring",
    "tags": ["network", "vans"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Van Locations",
        "type": "geomap",
        "gridPos": {"x": 0, "y": 0, "w": 24, "h": 10},
        "targets": [
          {
            "expr": "van_location_latitude",
            "refId": "A",
            "format": "table",
            "instant": true
          },
          {
            "expr": "van_location_longitude",
            "refId": "B",
            "format": "table",
            "instant": true
          },
          {
            "expr": "van_location_info",
            "refId": "C",
            "format": "table",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": []
          },
          "overrides": []
        },
        "options": {
          "basemap": {
            "type": "default",
            "name": "Default"
          },
          "layers": [
            {
              "type": "markers",
              "config": {
                "style": {
                  "size": {
                    "fixed": 15,
                    "min": 5,
                    "max": 30
                  },
                  "color": {
                    "fixed": "green"
                  },
                  "opacity": 0.8
                },
                "name": "Van Locations",
                "showLegend": true
              },
              "location": {
                "mode": "coords",
                "latitude": "Value #A",
                "longitude": "Value #B"
              },
              "tooltip": {
                "mode": "details"
              }
            }
          ],
          "view": {
            "id": "zero",
            "lat": 0,
            "lon": 0,
            "zoom": 2
          },
          "controls": {
            "showZoom": true,
            "showAttribution": true,
            "showScale": true,
            "showMeasure": true,
            "showDebug": false
          }
        },
        "transformations": [
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true
              },
              "indexByName": {},
              "renameByName": {
                "Value #A": "latitude",
                "Value #B": "longitude",
                "van_id #A": "van_id",
                "van_id #B": "van_id",
                "van_id #C": "van_id",
                "public_ip #C": "public_ip",
                "country #C": "country",
                "city #C": "city"
              }
            }
          }
        ]
      },
      {
        "id": 2,
        "title": "Van Internet Speed (Speedtest)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 10, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "van_speedtest_download_mbps",
            "legendFormat": "{{van_id}} - Download (Mbps)",
            "refId": "A"
          },
          {
            "expr": "van_speedtest_upload_mbps",
            "legendFormat": "{{van_id}} - Upload (Mbps)",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "Mbps",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 3,
        "title": "Van Ping Latency",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 10, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "van_speedtest_ping_ms",
            "legendFormat": "{{van_id}} - Ping (ms)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 4,
        "title": "Interface Download Speed (Real-time)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 18, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "van_interface_download_mbps",
            "legendFormat": "{{van_id}} - {{interface}} ({{ip}}) - Download",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "Mbps",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 5,
        "title": "Interface Upload Speed (Real-time)",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 18, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "van_interface_upload_mbps",
            "legendFormat": "{{van_id}} - {{interface}} ({{ip}}) - Upload",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "Mbps",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 6,
        "title": "Current Download Speed",
        "type": "stat",
        "gridPos": {"x": 0, "y": 26, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "van_speedtest_download_mbps",
            "legendFormat": "{{van_id}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "Mbps",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 10, "color": "yellow"},
                {"value": 50, "color": "green"}
              ]
            }
          }
        },
        "options": {
          "graphMode": "area",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 7,
        "title": "Current Upload Speed",
        "type": "stat",
        "gridPos": {"x": 6, "y": 26, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "van_speedtest_upload_mbps",
            "legendFormat": "{{van_id}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "Mbps",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 5, "color": "yellow"},
                {"value": 20, "color": "green"}
              ]
            }
          }
        },
        "options": {
          "graphMode": "area",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 8,
        "title": "Current Ping",
        "type": "stat",
        "gridPos": {"x": 12, "y": 26, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "van_speedtest_ping_ms",
            "legendFormat": "{{van_id}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 50, "color": "yellow"},
                {"value": 100, "color": "red"}
              ]
            }
          }
        },
        "options": {
          "graphMode": "area",
          "textMode": "value_and_name"
        }
      }
    ],
    "schemaVersion": 36,
    "version": 1,
    "refresh": "10s"
  }
}




